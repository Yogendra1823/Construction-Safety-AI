# Copy this file to .env and fill in your real values. Never commit .env itself.

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cih_db
DB_USER=root
DB_PASSWORD=your_mysql_password

# Used to sign session tokens / password reset tokens
SECRET_KEY=replace-with-a-long-random-string

# Optional: set to "sqlite" instead of "mysql" for zero-setup local testing.
# The app will then use a local cih_local.db file instead of MySQL.
DB_ENGINE=mysql

# Optional local LLM (Ollama running Gemma 3 1B) — powers free-form AI chat.
# Fully local, no API key, no data leaves your machine. Leave as-is if you
# don't have Ollama installed; the app detects it's unavailable and falls
# back to the rule-based assistant automatically.
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:1b
